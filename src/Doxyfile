# Doxyfile для проекта S21 3DViewer v2.0

# Проект
PROJECT_NAME           = "S21 3DViewer v2.0"
PROJECT_BRIEF          = "Реализация программы для визуализации каркасной модели в трёхмерном пространстве"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs/

# Входные файлы
INPUT                  = 
FILE_PATTERNS          = *.cc *.h
RECURSIVE              = YES

# Генерация документации
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# Оформление
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HAVE_DOT               = YES
DOT_GRAPH_MAX_NODES    = 100
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES

# Включение комментариев
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = YES

# Поддержка кириллицы
OUTPUT_LANGUAGE        = Russian
ENCODING               = UTF-8

# Дополнительное комментирование
GENERATE_TODOLIST      = YES
GENERATE_TESTLIST      = YES
GENERATE_BUGLIST       = YES

# Дополнительные настройки
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_FORMAT            = "$file:$line: $text"
WARN_LINE_FORMAT       = "at line $line of file $file"
GENERATE_TREEVIEW      = YES
MARKDOWN_SUPPORT       = YES
# USE_MDFILE_AS_MAINPAGE = ../README_RUS.md
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the
SHOW_INCLUDE_FILES     = YES